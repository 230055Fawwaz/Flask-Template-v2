# ==========================================
# Nama File:          .env.example
# Deskripsi File:     Template contoh variabel lingkungan (environment variables)
# Penulis File:       Fawwaz Yaqzhan & Google Antigravity
# Tanggal Pembuatan:  06-09-2026
# Tanggal Pembaruan:  06-09-2026
# Catatan:
#   - Salin file ini menjadi .env untuk penggunaan lokal
#   - Jangan pernah menyertakan SECRET_KEY produksi ke dalam git
#   - Konfigurasi host dan port server Flask
# ==========================================

# Kunci rahasia session Flask
SECRET_KEY=ganti-dengan-kunci-rahasia-acak-anda-disini

# Konfigurasi Server
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=True

# URL Database (Default menggunakan SQLite di folder instance/)
# DATABASE_URL=sqlite:///instance/app.db
